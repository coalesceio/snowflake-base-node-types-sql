{# == Node Type Name           : Work  == #}
{# == Node Type Description    : This node creates work table or view  == #}
{#---------------------------------------------------------------------------------------------#}

{%- set nsNodeVariables = namespace(currentDatabaseSchema = "",
                                    desiredDatabaseSchema = "",
                                    desObjectNameFullPath = "",
                                    curObjectNameFullPath = "",
                                    metaDataChanged = false) %}
{{ initializeNodeVariables(nsNodeVariables) }}

{#- Resolves the desired/current materialization type, including "transient table".
    Empty string when the state is absent (first deploy has no currentState; delete has no desiredState). #}
{%- set desiredMatType = desiredState.node.materializationType if desiredState is defined else '' %}
{%- set currentMatType = currentState.node.materializationType if currentState is defined else '' %}

{#- Stage-name labels: "<materialization> <full path>", e.g. view "DB"."SCHEMA"."WRK_CUSTOMER".
    Every stage is named "<Action> <label>" plus a ": <what changed>" / "(<reason>)" suffix where useful. #}
{%- set desLabel = desiredMatType + ' ' + nsNodeVariables.desObjectNameFullPath if desiredState is defined else '' %}
{%- set curLabel = currentMatType + ' ' + nsNodeVariables.curObjectNameFullPath if currentState is defined else '' %}

{%- if desiredState %}

    {# Validate: the same name+location tag repeated on the same column/node is not allowed #}
    {%- set nodeDupeTags = tag_validate(config.tag) %}
    {%- if nodeDupeTags | trim | length > 0 %}
        {{ test_stage('Duplicate Tags Found: ' + node.name, false) }}
        SELECT '{{ nodeDupeTags | escape }} is applied multiple times on {{ node.name | escape }}' AS "ERROR_MESSAGE"
    {%- endif %}

    {%- for col in columns %}
        {%- set colDupeTags = tag_validate(col.tag) %}
        {%- if colDupeTags | trim | length > 0 %}
            {{ test_stage('Duplicate Tags Found: ' + col.name, false) }}
            SELECT '{{ colDupeTags | escape }} is applied multiple times on {{ col.name | escape }}' AS "ERROR_MESSAGE"
        {%- endif %}
    {%- endfor %}

    {%- if desiredMatType == 'view' %}

        {%- if currentState is defined and (
                (currentMatType != desiredMatType)
                or (nsNodeVariables.curObjectNameFullPath != nsNodeVariables.desObjectNameFullPath)
            )
        %}
            {%- if currentMatType != desiredMatType %}
                {{ stage('Drop ' + curLabel + ' (replaced by ' + desiredMatType + ')') }}
            {%- else %}
                {{ stage('Drop ' + curLabel + ' (renamed/moved to ' + nsNodeVariables.desObjectNameFullPath + ')') }}
            {%- endif %}
            {%- set materialization = dropMaterialization(currentMatType) %}
            DROP {{ materialization }} {{ nsNodeVariables.curObjectNameFullPath }}
        {%- endif %}

        {# Did anything besides tags change? (columns, data type, or the underlying SELECT) #}
        {%- set nsViewTransforms = namespace(desired=[], current=[]) %}
        {%- if currentState is defined %}
            {%- for col in sources[0].columns %}
                {%- set nsViewTransforms.desired = nsViewTransforms.desired + [get_source_transform(col)] %}
            {%- endfor %}
            {%- for col in currentState.sources[0].columns %}
                {%- set nsViewTransforms.current = nsViewTransforms.current + [get_source_transform(col)] %}
            {%- endfor %}
        {%- endif %}
        {# Collect what changed besides tags, so the recreate stage can name it #}
        {%- set nsViewChanges = namespace(items=[]) %}
        {%- if currentState is defined %}
            {%- if (desiredState.columns | map(attribute='name') | list) != (currentState.columns | map(attribute='name') | list) %}
                {%- set nsViewChanges.items = nsViewChanges.items + ['columns'] %}
            {%- endif %}
            {%- if (desiredState.columns | map(attribute='dataType') | map('upper') | map('replace', ' ', '') | list) != (currentState.columns | map(attribute='dataType') | map('upper') | map('replace', ' ', '') | list) %}
                {%- set nsViewChanges.items = nsViewChanges.items + ['column data types'] %}
            {%- endif %}
            {%- if (desiredState.columns | map(attribute='description') | list) != (currentState.columns | map(attribute='description') | list) %}
                {%- set nsViewChanges.items = nsViewChanges.items + ['column descriptions'] %}
            {%- endif %}
            {%- if currentState.node.description != desiredState.node.description %}
                {%- set nsViewChanges.items = nsViewChanges.items + ['description'] %}
            {%- endif %}
            {%- if currentState.sources[0].cteString != desiredState.sources[0].cteString
                    or currentState.sources[0].join != desiredState.sources[0].join
                    or (currentState.sources[0].selectModifier | default('', true)) != (desiredState.sources[0].selectModifier | default('', true))
                    or (currentState.sources[0].columns | map(attribute='name') | list) != (desiredState.sources[0].columns | map(attribute='name') | list)
                    or nsViewTransforms.current != nsViewTransforms.desired %}
                {%- set nsViewChanges.items = nsViewChanges.items + ['query'] %}
            {%- endif %}
        {%- endif %}
        {%- set viewNonTagChanged = (nsViewChanges.items | length > 0) if currentState is defined else true %}

        {# CreateSQL for View #}
        {%- if currentState is not defined
                or currentMatType != desiredMatType
                or nsNodeVariables.curObjectNameFullPath != nsNodeVariables.desObjectNameFullPath
                or viewNonTagChanged %}
            {%- if currentState is not defined %}
                {{ stage('Create ' + desLabel) }}
            {%- elif currentMatType != desiredMatType %}
                {{ stage('Create ' + desLabel + ' (was ' + currentMatType + ')') }}
            {%- elif nsNodeVariables.curObjectNameFullPath != nsNodeVariables.desObjectNameFullPath %}
                {{ stage('Create ' + desLabel + ' (moved from ' + nsNodeVariables.curObjectNameFullPath + ')') }}
            {%- else %}
                {{ stage('Recreate ' + desLabel + ': ' + (nsViewChanges.items | join(', ')) + ' changed') }}
            {%- endif %}
            CREATE OR REPLACE {{ desiredMatType }} {{ nsNodeVariables.desObjectNameFullPath }}
            (
                {%- for col in columns %}
                    "{{ col.name }}"
                    {{ tag_with_clause(col.tag) }}
                    {%- if col.description | trim | length > 0 %} COMMENT '{{ col.description | escape }}' {%- endif %}
                    {%- if not loop.last -%}, {%- endif %}
                {%- endfor %}
            )
            {%- if desiredState.node.description | trim | length > 0 %} COMMENT = '{{ desiredState.node.description | escape }}' {%- endif %}
            {{ tag_with_clause(config.tag) }}
            AS
            {{ sources[0].cteString }}
            SELECT {{ sources[0].selectModifier | default('', true) }}
            {%- for col in sources[0].columns %}
                {{ get_source_transform(col) }} AS "{{ col.name }}"
                {%- if not loop.last -%}, {%- endif %}
            {%- endfor %}

            {{ sources[0].join }}

        {%- elif currentState is defined and not viewNonTagChanged %}

            {# Tag-only changes: alter the existing view's column- and node-level tags (unset before set) #}
            {{ tag_alter_sql(nsNodeVariables) }}

        {%- endif %}

    {%- elif desiredMatType in ['table', 'transient table']  %}

        {%- if currentState is defined and currentMatType != desiredMatType %}
            {{ stage('Drop ' + curLabel + ' (replaced by ' + desiredMatType + ')') }}
            {%- set materialization = dropMaterialization(currentMatType) %}
            DROP {{ materialization }} {{ nsNodeVariables.curObjectNameFullPath }}
        {%- endif %}

        {%- if currentState is not defined or currentMatType != desiredMatType %}

            {# CreateSQL for Table #}
            {%- if currentState is not defined %}
                {{ stage('Create ' + desLabel) }}
            {%- else %}
                {{ stage('Create ' + desLabel + ' (was ' + currentMatType + ')') }}
            {%- endif %}
            CREATE OR REPLACE {{ desiredMatType }} {{ nsNodeVariables.desObjectNameFullPath }}
            (
                {%- for col in columns %}
                    "{{ col.name }}" {{ col.dataType }}
                    {%- if col.nullable == false %} NOT NULL {%- endif %}
                    {%- if col.defaultValue %} DEFAULT {{ col.defaultValue }} {%- endif %}
                    {{ tag_with_clause(col.tag) }}
                    {%- if col.description | trim | length > 0 %} COMMENT '{{ col.description | escape }}' {%- endif %}
                    {%- if not loop.last -%}, {%- endif %}
                {%- endfor %}
            )
            {%- if desiredState.node.description | trim | length > 0 %} COMMENT = '{{ desiredState.node.description | escape }}' {%- endif %}
            {{ get_clusterby_sql() }}
            {{ tag_with_clause(config.tag) }}

        {%- elif currentState is defined and currentState != desiredState and currentMatType == desiredMatType %}

            {# Rename / Move Object #}
            {%- if nsNodeVariables.curObjectNameFullPath != nsNodeVariables.desObjectNameFullPath %}
                {{ stage('Rename ' + curLabel + ' to ' + nsNodeVariables.desObjectNameFullPath) }}

                ALTER TABLE IF EXISTS {{ nsNodeVariables.curObjectNameFullPath }}
                RENAME TO {{ nsNodeVariables.desObjectNameFullPath }}

                {# Metadata changes detected #}
                {%- set nsNodeVariables.metaDataChanged = true %}          
            {%- endif %}

            {# Change table description #}
            {%- if currentState.node.description != desiredState.node.description %}
                {{ stage('Change description of ' + desLabel) }}
                ALTER TABLE {{ nsNodeVariables.desObjectNameFullPath }}
                SET COMMENT = '{{ desiredState.node.description | escape }}'

                {# Metadata changes detected #}
                {%- set nsNodeVariables.metaDataChanged = true %} 
            {%- endif %}


            {# Drop Columns: collect first so the stage name can list them #}
            {%- set nsDropCols = namespace(items=[]) %}
            {%- for dropCurCol in currentState.columns %}
                {%- set idStillDesired = desiredState.columns | default([]) | selectattr('id', 'equalto', dropCurCol.id) | list %}
                {%- set nameStillDesired = dropCurCol.name in (desiredState.columns | default([]) | map(attribute="name") | list) %}
                {%- if not idStillDesired and not nameStillDesired %}
                    {%- set nsDropCols.items = nsDropCols.items + ['"' + dropCurCol.name + '"'] %}
                {%- endif %}
            {%- endfor %}

            {# Cluster key: build the desired and current CLUSTER BY terms, ordered by position.
               A term is the @clusterKey expression, or the quoted column name when none is given.
               "owner" is the column carrying the annotation, used to spot clustered columns being dropped. #}
            {%- set nsCluster = namespace(desired=[], current=[], desiredTerms=[], currentTerms=[],
                                          changed=false, droppedEarly=false) %}
            {%- for col in desiredState.columns %}
                {%- for cluster in col.clusterKey | default([]) %}
                    {%- set nsCluster.desired = nsCluster.desired + [{
                            "position": cluster.parameters[0] | int,
                            "term": cluster.parameters[1] | default('"' + col.name + '"', true)
                        }] %}
                {%- endfor %}
            {%- endfor %}
            {%- for col in currentState.columns %}
                {%- for cluster in col.clusterKey | default([]) %}
                    {%- set nsCluster.current = nsCluster.current + [{
                            "position": cluster.parameters[0] | int,
                            "term": cluster.parameters[1] | default('"' + col.name + '"', true),
                            "owner": '"' + col.name + '"'
                        }] %}
                {%- endfor %}
            {%- endfor %}
            {%- set nsCluster.desiredTerms = nsCluster.desired | sort(attribute='position') | map(attribute='term') | list %}
            {%- set nsCluster.currentTerms = nsCluster.current | sort(attribute='position') | map(attribute='term') | list %}
            {#- Whitespace-insensitive, so trunc(a,-5) vs trunc(a, -5) is not a change #}
            {%- set nsCluster.changed = (nsCluster.desiredTerms | map('replace', ' ', '') | list)
                                     != (nsCluster.currentTerms | map('replace', ' ', '') | list) %}

            {# A clustered column can't be dropped while it's in the key: drop the key first;
               the new key (if any) is re-applied after column adds/renames below #}
            {%- set nsClusterDrop = namespace(cols=[]) %}
            {%- for c in nsCluster.current %}
                {%- if c.owner in nsDropCols.items and c.owner not in nsClusterDrop.cols %}
                    {%- set nsClusterDrop.cols = nsClusterDrop.cols + [c.owner] %}
                {%- endif %}
            {%- endfor %}
            {#- Also drop early when the key is changing in the same deploy that drops columns:
                another column's expression may reference a dropped column, e.g. trunc("B", -5) on "A" #}
            {%- if nsClusterDrop.cols | length > 0
                    or (nsCluster.changed and nsDropCols.items | length > 0 and nsCluster.currentTerms | length > 0) %}
                {%- if nsClusterDrop.cols | length > 0 %}
                    {{ stage('Drop clustering key of ' + desLabel + ' (before dropping clustered columns: ' + (nsClusterDrop.cols | join(', ')) + ')') }}
                {%- else %}
                    {{ stage('Drop clustering key of ' + desLabel + ' (key changing while columns are dropped)') }}
                {%- endif %}
                ALTER TABLE {{ nsNodeVariables.desObjectNameFullPath }}
                DROP CLUSTERING KEY

                {%- set nsCluster.droppedEarly = true %}
                {# Metadata changes detected #}
                {%- set nsNodeVariables.metaDataChanged = true %}
            {%- endif %}

            {%- if nsDropCols.items | length > 0 %}
                {{ stage('Drop columns from ' + desLabel + ': ' + (nsDropCols.items | join(', '))) }}
                ALTER TABLE {{ nsNodeVariables.desObjectNameFullPath }}
                DROP COLUMN {{ nsDropCols.items | join(', ') }}

                {# Metadata changes detected #}
                {%- set nsNodeVariables.metaDataChanged = true %}
            {%- endif %}

            {# Add Columns: collect first so the stage name can list them #}
            {%- set nsAddCols = namespace(items=[]) %}
            {%- for addDesCol in desiredState.columns %}
                {%- set idAlreadyCurrent = currentState.columns | default([]) | selectattr('id', 'equalto', addDesCol.id) | list -%}
                {%- set nameAlreadyCurrent = addDesCol.name in (currentState.columns | default([]) | map(attribute="name") | list) -%}
                {%- if not idAlreadyCurrent and not nameAlreadyCurrent %}
                    {%- set nsAddCols.items = nsAddCols.items + [addDesCol] %}
                {%- endif %}
            {%- endfor %}

            {%- if nsAddCols.items | length > 0 %}
                {{ stage('Add columns to ' + desLabel + ': "' + (nsAddCols.items | map(attribute='name') | join('", "')) + '"') }}
                ALTER TABLE {{ nsNodeVariables.desObjectNameFullPath }}
                ADD COLUMN
                {%- for addDesCol in nsAddCols.items %}
                    "{{ addDesCol.name }}" {{ addDesCol.dataType }}
                    {%- if addDesCol.nullable == false %} NOT NULL {%- endif %}
                    {%- if addDesCol.defaultValue | length > 0 %} DEFAULT {{ addDesCol.defaultValue }} {%- endif %}
                    {{ tag_with_clause(addDesCol.tag) }}
                    {%- if addDesCol.description | trim | length > 0 %} COMMENT '{{ addDesCol.description | escape }}'{%- endif %}
                    {%- if not loop.last -%}, {%- endif %}
                {%- endfor %}

                {# Metadata changes detected #}
                {%- set nsNodeVariables.metaDataChanged = true %}
            {%- endif %}

            {# Rename Columns #}
            {%- for renameCurCol in currentState.columns %}
                {%- set idMatches = desiredState.columns | default([]) | selectattr('id', 'equalto', renameCurCol.id) | list %}
                {%- if idMatches and (idMatches | first).name != renameCurCol.name %}
                        {{ stage('Rename column "' + renameCurCol.name + '" to "' + (idMatches | first).name + '" in ' + desLabel) }}
                        ALTER TABLE {{ nsNodeVariables.desObjectNameFullPath }}
                        RENAME COLUMN "{{ renameCurCol.name }}"
                        TO "{{ (idMatches | first).name }}"

                        {# Metadata changes detected #}
                        {%- set nsNodeVariables.metaDataChanged = true %}
                {%- endif %}
            {%- endfor %}

            {# Change data types etc #}
            {%- for alterCurCol in currentState.columns %}

                {%- set matchingCols = desiredState.columns | default([])
                                    | selectattr('id', 'equalto', alterCurCol.id)
                                    | list
                -%}

                {%- if not matchingCols -%}
                    {%- set matchingCols = desiredState.columns | default([])
                                        | selectattr('name', 'equalto', alterCurCol.name)
                                        | list
                    -%}
                {%- endif -%}

                {%- if matchingCols -%}
                    {%- set desiredCol = matchingCols | first -%}
                {%- else -%}
                    {%- set desiredCol = none -%}
                {%- endif -%}

                {%- if desiredCol %}
                    {%- set currentDatatype = alterCurCol.dataType %}
                    {%- set currentNotNull = alterCurCol.nullable == false %}
                    {%- set currentDefaultValue = alterCurCol.defaultValue if alterCurCol.defaultValue else none %}
                    {%- set currentDescription = alterCurCol.description if alterCurCol.description else '' %}

                    {%- set desiredColumnName = desiredCol.name %}
                    {%- set desiredDatatype = desiredCol.dataType %}
                    {%- set desiredNotNull = desiredCol.nullable == false %}
                    {%- set desiredDefaultValue = desiredCol.defaultValue if desiredCol.defaultValue else none %}
                    {%- set desiredDescription = desiredCol.description if desiredCol.description else '' %}

                    {#- Case- and whitespace-insensitive, so varchar(10) vs VARCHAR(10) is not a change #}
                    {%- set datatypeTest = (currentDatatype | upper | replace(' ', '')) == (desiredDatatype | upper | replace(' ', '')) %}
                    {%- set nullableTest = currentNotNull == desiredNotNull %}
                    {%- set defaultValueTest = currentDefaultValue == desiredDefaultValue %}
                    {%- set descriptionTest = currentDescription == desiredDescription %}

                    {# One stage per changed column, named with the attributes that changed #}
                    {%- set nsColChange = namespace(labels=[], actions=[]) %}
                    {%- if datatypeTest == false %}
                        {%- set nsColChange.labels = nsColChange.labels + ['data type ' ~ currentDatatype ~ ' -> ' ~ desiredDatatype] %}
                        {%- set nsColChange.actions = nsColChange.actions + ['COLUMN "' + desiredColumnName + '" SET DATA TYPE ' ~ desiredDatatype] %}
                    {%- endif %}
                    {%- if nullableTest == false %}
                        {%- if desiredNotNull %}
                            {%- set nsColChange.labels = nsColChange.labels + ['set NOT NULL'] %}
                            {%- set nsColChange.actions = nsColChange.actions + ['COLUMN "' + desiredColumnName + '" SET NOT NULL'] %}
                        {%- else %}
                            {%- set nsColChange.labels = nsColChange.labels + ['drop NOT NULL'] %}
                            {%- set nsColChange.actions = nsColChange.actions + ['COLUMN "' + desiredColumnName + '" DROP NOT NULL'] %}
                        {%- endif %}
                    {%- endif %}
                    {%- if descriptionTest == false %}
                        {%- set nsColChange.labels = nsColChange.labels + ['description'] %}
                        {%- set nsColChange.actions = nsColChange.actions + ['COLUMN "' + desiredColumnName + '" COMMENT ' ~ "'" ~ (desiredDescription | escape) ~ "'"] %}
                    {%- endif %}
                    {%- if defaultValueTest == false %}
                        {%- if desiredDefaultValue == none %}
                            {%- set nsColChange.labels = nsColChange.labels + ['drop default'] %}
                            {%- set nsColChange.actions = nsColChange.actions + ['COLUMN "' + desiredColumnName + '" DROP DEFAULT'] %}
                        {%- else %}
                            {%- set nsColChange.labels = nsColChange.labels + ['default'] %}
                            {%- set nsColChange.actions = nsColChange.actions + ['COLUMN "' + desiredColumnName + '" SET DEFAULT ' ~ desiredDefaultValue] %}
                        {%- endif %}
                    {%- endif %}

                    {%- if nsColChange.actions | length > 0 %}
                        {{ stage('Change column "' + desiredColumnName + '" in ' + desLabel + ': ' + (nsColChange.labels | join(', '))) }}
                        ALTER TABLE {{ nsNodeVariables.desObjectNameFullPath }}
                        MODIFY {{ nsColChange.actions | join(', ') }}

                        {# Metadata changes detected #}
                        {%- set nsNodeVariables.metaDataChanged = true %}
                    {%- endif %}
                {%- endif %}
            {%- endfor %}

            {# Apply cluster key changes (computed before Drop Columns). Runs after column
               adds/renames so the new key can reference added or renamed columns. #}
            {%- if nsCluster.desiredTerms | length > 0 and (nsCluster.changed or nsCluster.droppedEarly) %}
                {{ stage('Change clustering key of ' + desLabel + ': ' + (nsCluster.desiredTerms | join(', '))) }}
                ALTER TABLE {{ nsNodeVariables.desObjectNameFullPath }}
                CLUSTER BY ({{ nsCluster.desiredTerms | join(', ') }})

                {# Metadata changes detected #}
                {%- set nsNodeVariables.metaDataChanged = true %}
            {%- elif nsCluster.desiredTerms | length == 0 and nsCluster.currentTerms | length > 0 and not nsCluster.droppedEarly %}
                {{ stage('Drop clustering key of ' + desLabel) }}
                ALTER TABLE {{ nsNodeVariables.desObjectNameFullPath }}
                DROP CLUSTERING KEY

                {# Metadata changes detected #}
                {%- set nsNodeVariables.metaDataChanged = true %}
            {%- endif %}

            {# Column- and node-level tag changes (unset before set) #}
            {{ tag_alter_sql(nsNodeVariables) }}

            {# == Compare source CTEs and Joins == #}
            {%- set cteStringTest = currentState.sources[0].cteString == desiredState.sources[0].cteString %}
            {%- set joinTest = currentState.sources[0].join == desiredState.sources[0].join %}

            {# == Handle undetected metadata changes and Default Update == #}
            {%- if not nsNodeVariables.metaDataChanged %}
                {{ stage('Update metadata for ' + desLabel + ' (no DDL change)') }}
                select 1=0
            {%- endif %}
        {%- endif %}
    {%- endif %}
{%- elif currentState is defined and desiredState is not defined %}

    {{ stage('Drop ' + curLabel + ' (node deleted)') }}
    {%- set materialization = dropMaterialization(currentMatType) %}
    DROP {{ materialization }} {{ nsNodeVariables.curObjectNameFullPath }}

{%- endif %}