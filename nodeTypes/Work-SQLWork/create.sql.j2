{# == Node Type Name           : Work  == #}
{# == Node Type Description    : This node creates work table or view  == #}
{#---------------------------------------------------------------------------------------------#}

{#- nsNodeVariables (object paths, metaDataChanged) is created and initialized in the shared macros #}

{#- Resolves the desired/current materialization type, including "transient table".
    Empty string when the state is absent (first deploy has no currentState; delete has no desiredState). #}
{%- set desiredMatType = desiredState.node.materializationType if desiredState is defined else '' %}
{%- set currentMatType = currentState.node.materializationType if currentState is defined else '' %}

{#- Stage-name labels: "<materialization> <full path>", e.g. view "DB"."SCHEMA"."WRK_CUSTOMER".
    Every stage is named "<Action> <label>" plus a ": <what changed>" / "(<reason>)" suffix where useful. #}
{%- set desLabel = desiredMatType + ' ' + nsNodeVariables.desObjectNameFullPath if desiredState is defined else '' %}

{%- if desiredState %}

    {# Validate: the same name+location tag repeated on the same column/node is not allowed #}
    {{ tag_check_duplicates() }}

    {%- if desiredMatType == 'view' %}

        {# Drop the current object if it was another type, or the view was renamed/moved #}
        {{ object_drop_sql() }}

        {# Did anything other than tags change? Render the view definition for both states
           without tags and compare: equal output means only tags (or nothing in the DDL) changed #}
        {%- set viewDefinitionChanged = currentState is not defined
                or (currentState != desiredState
                    and view_definition_sql(currentState, false) != view_definition_sql(desiredState, false)) %}

        {# CreateSQL for View #}
        {%- if currentState is not defined
                or currentMatType != desiredMatType
                or nsNodeVariables.curObjectNameFullPath != nsNodeVariables.desObjectNameFullPath
                or viewDefinitionChanged %}
            {%- if currentState is not defined %}
                {{ stage('Create ' + desLabel) }}
            {%- elif currentMatType != desiredMatType %}
                {{ stage('Create ' + desLabel + ' (was ' + currentMatType + ')') }}
            {%- elif nsNodeVariables.curObjectNameFullPath != nsNodeVariables.desObjectNameFullPath %}
                {{ stage('Create ' + desLabel + ' (moved from ' + nsNodeVariables.curObjectNameFullPath + ')') }}
            {%- else %}
                {{ stage('Recreate ' + desLabel + ' (definition changed)') }}
            {%- endif %}
            CREATE OR REPLACE {{ desiredMatType }} {{ nsNodeVariables.desObjectNameFullPath }}
            {{ view_definition_sql(desiredState) }}

        {%- elif currentState != desiredState %}

            {# Definition unchanged: alter tags only (unset before set), else record a metadata-only change #}
            {{ alter_tag_sql() }}
            {{ alter_metadata_sql() }}

        {%- endif %}

    {%- elif desiredMatType in ['table', 'transient table']  %}

        {# Drop the current object if it was another type (a table rename/move is altered in place) #}
        {{ object_drop_sql() }}

        {%- if currentState is not defined or currentMatType != desiredMatType %}

            {# CreateSQL for Table #}
            {%- if currentState is not defined %}
                {{ stage('Create ' + desLabel) }}
            {%- else %}
                {{ stage('Create ' + desLabel + ' (was ' + currentMatType + ')') }}
            {%- endif %}
            CREATE OR REPLACE {{ desiredMatType }} {{ nsNodeVariables.desObjectNameFullPath }}
            (
                {%- for col in columns %}
                    "{{ col.name }}" {{ col.dataType }}
                    {%- if col.nullable == false %} NOT NULL {%- endif %}
                    {%- if col.defaultValue %} DEFAULT {{ col.defaultValue }} {%- endif %}
                    {{ tag_with_clause(col.tag) }}
                    {%- if col.description | trim | length > 0 %} COMMENT '{{ col.description | escape }}' {%- endif %}
                    {%- if not loop.last -%}, {%- endif %}
                {%- endfor %}
            )
            {%- if desiredState.node.description | trim | length > 0 %} COMMENT = '{{ desiredState.node.description | escape }}' {%- endif %}
            {{ get_clusterby_sql() }}
            {{ tag_with_clause(config.tag) }}

        {%- elif currentState is defined and currentState != desiredState and currentMatType == desiredMatType %}

            {# Rename / Move Object #}
            {{ alter_rename_sql() }}

            {# Change table description #}
            {{ alter_description_sql() }}

            {# Cluster key: drop it first if clustered columns are being dropped #}
            {{ alter_drop_cluster_key_sql() }}

            {# Drop Columns #}
            {{ alter_drop_columns_sql() }}

            {# Add Columns #}
            {{ alter_add_columns_sql() }}

            {# Rename Columns (matched by id; a Work column whose id changed is dropped + added instead) #}
            {{ alter_rename_columns_sql() }}

            {# Change column attributes (data type, nullability, description, default) #}
            {{ alter_modify_columns_sql() }}

            {# Cluster key: apply the new key (after column adds/renames, so it can reference them) #}
            {{ alter_cluster_key_sql() }}

            {# Column- and node-level tag changes (unset before set) #}
            {{ alter_tag_sql() }}

            {# Nothing above altered the table: record a metadata-only change #}
            {{ alter_metadata_sql() }}
        {%- endif %}
    {%- endif %}
{%- elif currentState is defined and desiredState is not defined %}

    {# Node deleted: drop the current object #}
    {{ object_drop_sql() }}

{%- endif %}